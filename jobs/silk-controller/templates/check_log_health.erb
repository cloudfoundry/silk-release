#!/bin/bash
set -e

echo "Starting silk-controller log-level check..."

PORT="<%= p("debug_port") %>"
URL="http://127.0.0.1:$PORT/log-level"

RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" -X POST "$URL" \
  --data "error" --max-time 10)

echo "Response code: $RESPONSE"

if [ "$RESPONSE" -ne 200 ]; then
  echo "Check failed"
  exit 1
fi

echo "Check passed"
exit 0
